# ── Supabase (public anon + project URL) ─────────────────────────────
# Get these from Supabase dashboard → Project Settings → API
# The "anon" / "publishable" key is SAFE to expose in client code.
# Never put the "service_role" key here — that bypasses RLS.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_ANON_KEY"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT_REF"

# ── Solana RPC (server-side, for edge functions) ────────────────────
# Public mainnet RPC works for read-only. For write operations, use a
# private RPC (Triton, Helius, QuickNode) and store the key in
# Supabase secrets — NOT here.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_NETWORK="mainnet-beta"   # mainnet-beta | devnet | testnet

# ── Token addresses ─────────────────────────────────────────────────
# Devnet mint (for development only):
VITE_FOT_MINT_DEVNET="4zaq8xFC2grs6u9q9gjSiQCPqmXCJeqKk9b1UiHzRovA"

# Mainnet mint — set after mainnet deploy. Empty until then.
VITE_FOT_MINT_MAINNET=""

# ── FOT pricing (display only — actual price is set by the AMM) ────
VITE_FOT_PRICE_USD="0.10"

# ── Optional: analytics ────────────────────────────────────────────
# Statcounter project ID (matches the script tag in index.html)
VITE_STATCOUNTER_PROJECT="13169249"
VITE_STATCOUNTER_SECURITY="3acdd18b"
